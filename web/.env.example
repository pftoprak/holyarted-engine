# Public address of the site, e.g. https://holyarted.com (share previews, sitemap).
SITE_URL=
HOLYARTED_ACCOUNTS_ENABLED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=service_role_replace_me
# Payment provider: iyzico (default) or stripe.
BILLING_PROVIDER=iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
IYZICO_PLUS_PLAN_CODE=
IYZICO_PREMIUM_PLAN_CODE=
# Sandbox unless set: https://api.iyzipay.com for live payments.
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PLUS_PRICE_ID=price_replace_me
STRIPE_PREMIUM_PRICE_ID=price_replace_me
# Optional: Slack or Discord webhook that receives server failure alerts.
ERROR_REPORT_URL=
# Optional: long random secret (32+ characters) for scripts/grant.mjs. Unset turns the admin route off.
ADMIN_TOKEN=
